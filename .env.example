# Both providers are opt-in. Empty allowlists deny all conversations.
QQ_ENABLE_OFFICIAL=false
QQ_APP_ID=
QQ_APP_SECRET=
# Official bot-scoped open IDs, comma-separated (not numeric personal QQ IDs)
QQ_OFFICIAL_GROUPS=
QQ_OFFICIAL_USERS=

QQ_ENABLE_PERSONAL=false
QQ_NAPCAT_URL=http://127.0.0.1:3000
QQ_NAPCAT_TOKEN=
# Numeric personal QQ group/friend IDs, comma-separated
QQ_PERSONAL_GROUPS=
QQ_PERSONAL_USERS=
QQ_ALLOW_REMOTE_NAPCAT=false

QQ_ENABLE_SEND=false
# Set an absolute path; BOTH stdio and webhook processes must use the SAME file.
# QQ_STATE_PATH=D:/private/qq-mcp/state.sqlite3
QQ_RETENTION_SECONDS=86400
QQ_MAX_MESSAGES=2000
QQ_REQUEST_TIMEOUT=15
QQ_WEBHOOK_PORT=8787
